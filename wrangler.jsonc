{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static assets only: Vite's `dist/` served by Cloudflare's edge, no Worker script.
  "name": "airguitar",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "airguitar.veszelovszki.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
}
